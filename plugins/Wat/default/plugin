#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
	cat <<'USAGE'
Usage: plugin meta <script>
       plugin doctor
       plugin help
USAGE
}

meta() {
	local script_path="${1:-}"
	if [[ -z "${script_path}" ]]; then
		echo "meta requires script path" >&2
		exit 1
	fi

	local script_base artifact_rel
	script_base="$(basename "${script_path}")"
	artifact_rel="wasm/${script_base%.*}.wasm"
	if [[ "${artifact_rel}" == "wasm/.wasm" ]]; then
		artifact_rel="wasm/artifact.wasm"
	fi

	local skip_build="${JUMPSCRIPT_NO_BUILD_DEPS:-0}"
	local skip_runtime="${JUMPSCRIPT_NO_RUNTIME_DEPS:-0}"

	local build_cmd
	if [[ "${skip_build}" == "1" ]]; then
		if ! command -v wat2wasm >/dev/null 2>&1; then
			echo "wat plugin requires 'wat2wasm' on PATH when --no-build-deps is set" >&2
			exit 1
		fi
		build_cmd='set -e; tail -n +2 "$JUMPSCRIPT_SCRIPT" | wat2wasm -o "$JUMPSCRIPT_ARTIFACT" -'
	else
		build_cmd="nix develop ${plugin_dir}#build --command bash --noprofile --norc -lc 'set -e; tail -n +2 \"\$JUMPSCRIPT_SCRIPT\" | wat2wasm -o \"\$JUMPSCRIPT_ARTIFACT\" -'"
	fi

	local runtime_cmd
	if [[ "${skip_runtime}" == "1" ]]; then
		local host_wazero
		host_wazero="$(command -v wazero || true)"
		if [[ -z "${host_wazero}" ]]; then
			echo "wat plugin requires 'wazero' on PATH when --no-runtime-deps is set" >&2
			exit 1
		fi
		runtime_cmd="${host_wazero} run {{artifact}}"
	else
		local current_system wazero_store wazero_bin
		current_system="$(nix eval --raw --impure --expr 'builtins.currentSystem')"
		wazero_store="$(nix eval --raw --impure "${plugin_dir}#packages.${current_system}.wazero")"
		wazero_bin="${wazero_store}/bin/wazero"
		runtime_cmd="${wazero_bin} run {{artifact}}"
	fi

	cat <<META
lang=Wat
out_rel=${artifact_rel}
build_cmd=${build_cmd}
rebuild_mode=mtime
exec_kind=wasm
runtime_cmd=${runtime_cmd}
META
}

doctor() {
	if ! command -v nix >/dev/null 2>&1; then
		echo "status=missing-nix"
		exit 1
	fi
	echo "status=ok"
}

case "${1:-}" in
	meta)
		shift
		meta "$@"
		;;
	doctor)
		shift
		doctor "$@"
		;;
	help)
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
