#!/usr/bin/env bash
# Builds the jumpscript runner into bin/jumpscript (ReleaseFast by default).
# Usage: ./build [--debug] [--test]
#   --debug  a Debug build (it announces itself on stderr)
#   --test   also run the core unit tests
set -u
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
optimize=ReleaseFast
run_tests=0
for a in "$@"; do
	case "$a" in
		--debug) optimize=Debug ;;
		--test) run_tests=1 ;;
		-h | --help) sed -n '2,5p' "$0"; exit 0 ;;
		*) echo "build: unknown option '$a'" >&2; exit 2 ;;
	esac
done
cd "$root" || exit 1
steps=(install)
[ "$run_tests" -eq 1 ] && steps+=(test)
exec nix develop "$root" -c zig build "${steps[@]}" -Doptimize="$optimize" --prefix "$root"
