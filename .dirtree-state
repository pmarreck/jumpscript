# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
depth=4

hide=[
	.claude
	.git
	.jj
]

annotate=[
	INTENT.md = Purpose, users, outcomes, scope, constraints and open questions (canonical)
	PLAN.md = Open work in priority order (planning-work format)
	build = Builds the Zig runner into bin/jumpscript
	build.zig = Zig build: core unit tests (zig build test); default ReleaseFast
	docs/PLAN_LOG.md = Retired plan items, append-only
	docs/plan_context = Background for plan items
	docs/plan_context/toolchain_pins.md = Draft lookup rules for toolchain pins: script directive, plugin flake.lock, jumpscript update
	flake.nix = Dev shell, packages.default (runner plus plugins), checks
	plugins/_lib/plugin_lib.bash = Pure-Bash stand-ins for cat, tail and grep used by plugins before Nix supplies tools
	src/core.zig = Zig runner pure core: argv parsing, meta parse/validate, out_rel containment, runtime expansion, deps, cache entry key, staleness, meta-cache key and file format
	src/main.zig = Zig runner I/O adapter: plugin lookup, meta cache, secure cache dirs, build, exec
	tests/lib/host.bash = minimal_host_dir: a PATH dir with only nix and bash for integration tests
	tests/test_concurrency.sh = Concurrent cold runs: one build per entry; cache dirs never seen with mode other than 700 (strace-forced window on Linux)
	tests/test_meta_cache.sh = When a cached plugin meta answer is reused or recomputed
	tests/test_plugin_lib.sh = plugin_lib helpers checked against cat, tail and grep as oracles
	tests/test_zig_core.sh = Runs the Zig core unit tests in ReleaseFast and Debug
]
