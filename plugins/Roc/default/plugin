#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# Pure-Bash helpers: before the flake supplies tools, only nix and bash are assumed.
source "${plugin_dir}/../../_lib/plugin_lib.bash"
basic_cli_url="https://github.com/roc-lang/basic-cli/releases/download/0.23.0/GNN5tt2gKdX4dhawg4915C4YB193woHFdcCkz31fhGxv.tar.zst"

usage() {
	pl_cat <<'USAGE'
Usage: plugin [--backend=native|luajit|wasm] meta <script>
       plugin doctor
       plugin help

The backend comes from the shebang's language token, which selects this
plugin's variant directory, or else from the script's double extension:
  jumpscript Roc-luajit, or name.lua.roc   roc build --target=luajit, run with LuaJIT
  jumpscript Roc-wasm, or name.wasm.roc    roc build --target=wasm32, run with wasmtime
  jumpscript Roc (any other name)          roc build --opt=speed, run natively
Extensionless scripts therefore name their backend in the shebang. A named
backend that contradicts the double extension is an error.
The compiler is Roc with the LuaJIT backend, from the roc_luajit flake this
plugin pins (built on first use); $JUMPSCRIPT_ROC overrides it, and
--no-build-deps uses `roc` on PATH.

A wasm script is a basic-cli 0.23.0 app. It builds against the WASI copy of
basic-cli from the same flake ($JUMPSCRIPT_ROC_WASI_PLATFORM, a directory
holding its main.roc, overrides it) and runs with the whole filesystem
preopened and the environment inherited, as a native terminal app would.
USAGE
}

# The Roc compiler to build with: JUMPSCRIPT_ROC, else roc on PATH.
resolve_roc() {
	if [[ -n "${JUMPSCRIPT_ROC:-}" ]]; then
		if [[ ! -x "${JUMPSCRIPT_ROC}" ]]; then
			echo "Roc plugin: JUMPSCRIPT_ROC is not an executable Roc compiler (got '${JUMPSCRIPT_ROC}')" >&2
			exit 1
		fi
		printf '%s\n' "${JUMPSCRIPT_ROC}"
		return
	fi
	if [[ "${JUMPSCRIPT_NO_BUILD_DEPS:-0}" == "1" ]]; then
		local host
		host="$(command -v roc || true)"
		if [[ -z "${host}" ]]; then
			echo "Roc plugin requires 'roc' on PATH when --no-build-deps is set" >&2
			exit 1
		fi
		printf '%s\n' "${host}"
		return
	fi
	# Roc with the LuaJIT backend, from the roc_luajit flake this plugin pins.
	local store
	store="$(nix build --no-link --print-out-paths "${plugin_dir}#roc")"
	printf '%s\n' "${store}/bin/roc"
}

resolve_luajit() {
	if [[ "${JUMPSCRIPT_NO_RUNTIME_DEPS:-0}" == "1" ]]; then
		local host
		host="$(command -v luajit || true)"
		if [[ -z "${host}" ]]; then
			echo "Roc plugin requires 'luajit' on PATH when --no-runtime-deps is set" >&2
			exit 1
		fi
		printf '%s\n' "${host}"
		return
	fi
	# Built (realized), not just evaluated: an evaluated store path may not exist yet.
	local store
	store="$(nix build --no-link --print-out-paths "${plugin_dir}#luajit")"
	printf '%s\n' "${store}/bin/luajit"
}

resolve_wasmtime() {
	if [[ "${JUMPSCRIPT_NO_RUNTIME_DEPS:-0}" == "1" ]]; then
		local host
		host="$(command -v wasmtime || true)"
		if [[ -z "${host}" ]]; then
			echo "Roc plugin requires 'wasmtime' on PATH when --no-runtime-deps is set" >&2
			exit 1
		fi
		printf '%s\n' "${host}"
		return
	fi
	local store
	store="$(nix build --no-link --print-out-paths "${plugin_dir}#wasmtime")"
	printf '%s\n' "${store}/bin/wasmtime"
}

# The WASI copy of basic-cli 0.23.0 that .wasm.roc scripts build against,
# as an absolute directory.
resolve_wasi_platform() {
	local dir="${JUMPSCRIPT_ROC_WASI_PLATFORM:-}"
	if [[ -z "${dir}" ]]; then
		# The WASI copy of basic-cli 0.23.0, built by the roc_luajit flake.
		nix build --no-link --print-out-paths "${plugin_dir}#wasi-basic-cli"
		return
	fi
	if [[ ! -f "${dir}/main.roc" ]]; then
		echo "Roc plugin: JUMPSCRIPT_ROC_WASI_PLATFORM must name a directory holding the WASI basic-cli platform's main.roc (got '${dir}')" >&2
		exit 1
	fi
	(cd "${dir}" && pwd)
}

meta() {
	local script_path="${1:-}"
	if [[ -z "${script_path}" ]]; then
		echo "meta requires script path" >&2
		exit 1
	fi

	local roc script_base ext_backend="" backend stem suffix
	roc="$(resolve_roc)"
	script_base="${script_path##*/}"
	case "${script_base}" in
		?*.lua.roc) ext_backend=luajit ;;
		?*.wasm.roc) ext_backend=wasm ;;
	esac
	if [[ -n "${declared_backend}" && -n "${ext_backend}" && "${ext_backend}" != "${declared_backend}" ]]; then
		echo "Roc plugin: jumpscript Roc-${declared_backend} conflicts with the ${ext_backend} double extension of ${script_path}" >&2
		exit 1
	fi
	backend="${declared_backend:-${ext_backend:-native}}"
	# The artifact name drops whichever Roc suffix the script has, if any.
	stem="${script_base}"
	for suffix in .lua.roc .wasm.roc .roc; do
		if [[ "${stem}" == ?*"${suffix}" ]]; then
			stem="${stem%"${suffix}"}"
			break
		fi
	done

	if [[ "${backend}" == wasm ]]; then
		local platform wasmtime
		platform="$(resolve_wasi_platform)"
		wasmtime="$(resolve_wasmtime)"
		pl_cat <<META
lang=Roc
out_rel=wasm/${stem}.wasm
build_cmd='${roc}' build --target=wasm32 --opt=speed --replace-dep ${basic_cli_url} '${platform}/main.roc' "\$JUMPSCRIPT_SCRIPT" --output="\$JUMPSCRIPT_ARTIFACT" >&2
rebuild_mode=mtime
exec_kind=wasm
runtime_cmd=${wasmtime} run -S inherit-env=y --dir=/ {{artifact}}
META
		return
	fi
	if [[ "${backend}" == luajit ]]; then
		local luajit
		luajit="$(resolve_luajit)"
		pl_cat <<META
lang=Roc
out_rel=lua/${stem}.lua
build_cmd='${roc}' build --target=luajit "\$JUMPSCRIPT_SCRIPT" --output="\$JUMPSCRIPT_ARTIFACT" >&2
rebuild_mode=mtime
exec_kind=lua
runtime_cmd=${luajit} {{artifact}}
META
	else
		pl_cat <<META
lang=Roc
out_rel=bin/${stem}
build_cmd='${roc}' build --opt=speed "\$JUMPSCRIPT_SCRIPT" --output="\$JUMPSCRIPT_ARTIFACT" >&2
rebuild_mode=mtime
exec_kind=bin
META
	fi
}

doctor() {
	resolve_roc >/dev/null
	echo "status=ok"
}

# Set by the Roc-luajit and Roc-wasm variant plugins.
declared_backend=""
case "${1:-}" in
	--backend=native) shift ;;
	--backend=luajit | --backend=wasm) declared_backend="${1#--backend=}"; shift ;;
	--backend=*) echo "Roc plugin: unknown backend '${1#--backend=}' (native, luajit, wasm)" >&2; exit 1 ;;
esac

case "${1:-}" in
	meta)
		shift
		meta "$@"
		;;
	doctor)
		shift
		doctor "$@"
		;;
	help)
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
