#!/usr/bin/env bash
set -euo pipefail

base_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
plugins_root="${JUMPSCRIPT_PLUGINS_DIR:-${base_dir}/plugins}"
default_user_plugins_root="${XDG_DATA_HOME:-${HOME}/.local/share}/jumpscript/plugins"
user_plugins_root="${JUMPSCRIPT_USER_PLUGINS:-${default_user_plugins_root}}"

summary="jumpscript: cached edit-run harness for compiled languages"

get_default_cache_root() {
	local cache_base="${XDG_CACHE_HOME:-${HOME}/.cache}"
	echo "${cache_base}/jumpscript-artifacts"
}

show_about() {
	echo "${summary}"
	exit 0
}

show_help() {
	local default_cache_root current_cache_root current_user_plugins_root
	default_cache_root="$(get_default_cache_root)"
	current_cache_root="${JUMPSCRIPT_CACHE:-${default_cache_root}}"
	current_user_plugins_root="${user_plugins_root}"
	cat <<EOF
Usage: jumpscript run <Language[-Version]> <script> [args...]

${summary}

Cache:
  Default cache root: ${default_cache_root}
  Current cache root: ${current_cache_root}
  Cache overrides: JUMPSCRIPT_CACHE, XDG_CACHE_HOME

Plugins:
  Bundled plugins dir: ${plugins_root}
  Plugins override: JUMPSCRIPT_PLUGINS_DIR

User Plugins:
  User plugins search root: ${current_user_plugins_root}
  User plugins overrides: JUMPSCRIPT_USER_PLUGINS, XDG_DATA_HOME
EOF
	exit 0
}

command="${1:-}"

die() {
	echo "Error: $1" >&2
	exit "${2:-1}"
}

get_permissions() {
	local target="$1"
	if perm=$(stat -c %a "${target}" 2>/dev/null); then
		echo "${perm}"
		return 0
	fi
	if perm=$(stat -f %Lp "${target}" 2>/dev/null); then
		echo "${perm}"
		return 0
	fi
	return 1
}

get_mtime() {
	local target="$1"
	if mtime=$(stat -c %Y "${target}" 2>/dev/null); then
		echo "${mtime}"
		return 0
	fi
	if mtime=$(stat -f %m "${target}" 2>/dev/null); then
		echo "${mtime}"
		return 0
	fi
	return 1
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		-a|--about)
			show_about
			;;
		-h|--help)
			show_help
			;;
		--)
			shift
			break
			;;
		-*)
			die "unsupported option '$1'"
			;;
		*)
			break
			;;
	esac
done

command="${1:-}"

if [[ -z "${command}" ]]; then
	die "no command provided"
fi

if [[ "${command}" != "run" ]]; then
	set -- run "$@"
	command="run"
fi

case "${command}" in
	run)
		shift
		;;
	*)
		die "unsupported command '${command}'"
		;;
esac

lang_token="${1:-}"
[[ -n "${lang_token}" ]] || die "language token is required"
shift

script_path="${1:-}"
[[ -n "${script_path}" ]] || die "script path is required"

if [[ ! -f "${script_path}" ]]; then
	die "script '${script_path}' not found"
fi

if [[ "${script_path}" != /* ]]; then
	script_path="$(cd "$(dirname "${script_path}")" && pwd)/$(basename "${script_path}")"
fi

shift
script_args=("$@")

if [[ "${lang_token}" == *-* ]]; then
	lang="${lang_token%%-*}"
	version="${lang_token#*-}"
else
	lang="${lang_token}"
	version="default"
fi

plugin_dir=""
search_roots=()

if [[ -n "${user_plugins_root}" ]]; then
	search_roots+=("${user_plugins_root}")
fi
search_roots+=("${plugins_root}")

for root in "${search_roots[@]}"; do
	[[ -n "${root}" ]] || continue
	candidate="${root}/${lang}/${version}"
	if [[ -d "${candidate}" ]]; then
		plugin_dir="${candidate}"
		break
	fi
done

if [[ -z "${plugin_dir}" ]]; then
	joined_paths="$(IFS=','; printf '%s' "${search_roots[*]}")"
	die "plugin not found for language '${lang}' version '${version}' (searched: ${joined_paths})"
fi

plugin_exec="${plugin_dir}/plugin"
if [[ ! -x "${plugin_exec}" ]]; then
	die "plugin executable not found at ${plugin_exec}"
fi

set +e
plugin_meta_output="$("${plugin_exec}" meta "${script_path}" 2> >(cat >&2))"
plugin_meta_status=$?
set -e

if [[ "${plugin_meta_status}" -ne 0 ]]; then
	die "plugin '${lang}' meta command failed with exit code ${plugin_meta_status}" "${plugin_meta_status}"
fi

declare -A plugin_meta=()
while IFS='=' read -r key value; do
	if [[ -z "${key}" ]]; then
		continue
	fi
	plugin_meta["${key}"]="${value}"
done <<< "${plugin_meta_output}"

required_meta_fields=(out_rel build_cmd rebuild_mode exec_kind)
for field in "${required_meta_fields[@]}"; do
	if [[ -z "${plugin_meta[${field}]:-}" ]]; then
		die "plugin '${lang}' meta output missing required field '${field}'"
	fi
done

runtime_cmd="${plugin_meta[runtime_cmd]:-}"

case "${plugin_meta[rebuild_mode]}" in
	mtime)
		;;
	*)
		die "plugin '${lang}' requested unsupported rebuild_mode '${plugin_meta[rebuild_mode]}'"
		;;
esac

case "${plugin_meta[exec_kind]}" in
	bin|lua|wasm|beam|text)
		;;
	*)
		die "plugin '${lang}' reported unsupported exec_kind '${plugin_meta[exec_kind]}'"
		;;
esac

default_cache_root="$(get_default_cache_root)"
cache_root="${JUMPSCRIPT_CACHE:-${default_cache_root}}"
if [[ -d "${cache_root}" ]]; then
	existing_perm="$(get_permissions "${cache_root}")" || die "unable to determine permissions of '${cache_root}'"
	if [[ "${existing_perm}" != "700" ]]; then
		die "cache root '${cache_root}' has permissions ${existing_perm}; expected 700"
	fi
else
	mkdir -p "${cache_root}"
	chmod 700 "${cache_root}"
fi

ensure_secure_dir() {
	local dir="$1"
	local perm=""
	if [[ -d "${dir}" ]]; then
		perm="$(get_permissions "${dir}")" || die "unable to determine permissions of '${dir}'"
		if [[ "${perm}" != "700" ]]; then
			die "directory '${dir}' has permissions ${perm}; expected 700"
		fi
	else
		mkdir -p "${dir}"
		chmod 700 "${dir}"
	fi
}

lang_dir="${cache_root}/${lang}"
version_dir="${lang_dir}/${version}"

ensure_secure_dir "${lang_dir}"
ensure_secure_dir "${version_dir}"

script_mtime="$(get_mtime "${script_path}")" || die "unable to determine mtime for '${script_path}'"
script_basename="$(basename "${script_path}")"
script_dir="$(cd "$(dirname "${script_path}")" && pwd)"

deps_string="${plugin_meta[deps]:-}"
old_ifs="${IFS}"
IFS=':' read -r -a dep_rel_paths <<< "${deps_string}"
IFS="${old_ifs}"
declare -a dep_abs_paths=()
latest_mtime="${script_mtime}"
freshest_path="${script_path}"

for dep_rel in "${dep_rel_paths[@]}"; do
	[[ -z "${dep_rel}" ]] && continue
	if [[ "${dep_rel}" == /* ]]; then
		dep_path="${dep_rel}"
	else
		dep_path="${script_dir}/${dep_rel}"
	fi
	if [[ ! -e "${dep_path}" ]]; then
		die "dependency '${dep_rel}' for script '${script_path}' not found"
	fi
	dep_mtime="$(get_mtime "${dep_path}")" || die "unable to determine mtime for dependency '${dep_path}'"
	dep_abs_paths+=("${dep_path}")
	if (( dep_mtime > latest_mtime )); then
		latest_mtime="${dep_mtime}"
		freshest_path="${dep_path}"
	fi
done

entry_key="${script_basename}-${latest_mtime}"
entry_dir="${version_dir}/${entry_key}"

ensure_secure_dir "${entry_dir}"

artifact_rel="${plugin_meta[out_rel]}"
if [[ "${artifact_rel}" == /* ]]; then
	die "plugin '${lang}' out_rel '${artifact_rel}' escapes cache entry"
fi

old_ifs="${IFS}"
IFS='/'
read -ra artifact_segments <<< "${artifact_rel}"
IFS="${old_ifs}"
for segment in "${artifact_segments[@]}"; do
	if [[ "${segment}" == ".." ]]; then
		die "plugin '${lang}' out_rel '${artifact_rel}' escapes cache entry"
	fi
done

artifact_path="${entry_dir}/${artifact_rel}"

meta_file="${entry_dir}/meta.env"
{
	echo "out_rel=${plugin_meta[out_rel]}"
	echo "build_cmd=${plugin_meta[build_cmd]}"
	echo "rebuild_mode=${plugin_meta[rebuild_mode]}"
	echo "exec_kind=${plugin_meta[exec_kind]}"
	if [[ -n "${runtime_cmd}" ]]; then
		echo "runtime_cmd=${runtime_cmd}"
	fi
	if [[ -n "${deps_string}" ]]; then
		echo "deps=${deps_string}"
	fi
} > "${meta_file}"

artifact_dir="$(dirname "${artifact_path}")"
if [[ "${artifact_dir}" != "${entry_dir}" ]]; then
	ensure_secure_dir "${artifact_dir}"
fi

deps_env=""
if (( ${#dep_abs_paths[@]} )); then
	deps_env="$(printf '%s:' "${dep_abs_paths[@]}")"
	deps_env="${deps_env%:}"
fi

needs_build=1
if [[ -f "${artifact_path}" ]]; then
	artifact_mtime="$(get_mtime "${artifact_path}")" || artifact_mtime="0"
	if [[ "${artifact_mtime}" == "${latest_mtime}" ]]; then
		needs_build=0
	fi
fi

if [[ "${needs_build}" -eq 1 ]]; then
	build_cmd="${plugin_meta[build_cmd]}"
	set +e
	(
		set -e
		cd "${entry_dir}"
		JUMPSCRIPT_ENTRY_DIR="${entry_dir}" \
		JUMPSCRIPT_ARTIFACT="${artifact_path}" \
		JUMPSCRIPT_SCRIPT="${script_path}" \
		JUMPSCRIPT_OUT_REL="${artifact_rel}" \
		JUMPSCRIPT_LANG="${lang}" \
		JUMPSCRIPT_BUILD_CMD="${build_cmd}" \
		JUMPSCRIPT_SCRIPT_DIR="${script_dir}" \
		JUMPSCRIPT_DEPS="${deps_env}" \
		bash --noprofile --norc -lc "${build_cmd}"
	)
	build_status=$?
	set -e
	if [[ "${build_status}" -ne 0 ]]; then
		die "plugin '${lang}' build command failed with exit code ${build_status}" "${build_status}"
	fi

	if [[ ! -f "${artifact_path}" ]]; then
		die "plugin '${lang}' build command did not produce artifact '${artifact_rel}'"
	fi

	touch -r "${freshest_path}" "${artifact_path}"
fi

case "${plugin_meta[exec_kind]}" in
	bin)
		if [[ ! -x "${artifact_path}" ]]; then
			die "artifact '${artifact_rel}' is not executable"
		fi
		exec "${artifact_path}" "${script_args[@]}"
		;;
	lua|wasm|beam|text)
		if [[ -z "${runtime_cmd}" ]]; then
			die "plugin '${lang}' exec_kind '${plugin_meta[exec_kind]}' requires runtime_cmd"
		fi
		runtime_resolved="${runtime_cmd//\{\{artifact\}\}/${artifact_path}}"
		runtime_resolved="${runtime_resolved//\{\{script\}\}/${script_path}}"
		read -r -a runtime_parts <<< "${runtime_resolved}"
		exec "${runtime_parts[@]}" "${script_args[@]}"
		;;
	*)
		die "exec_kind '${plugin_meta[exec_kind]}' execution not implemented"
		;;
esac
