#!/usr/bin/env bash
# jumpscript - Nix-backed compiled script runner
# Author: pmarreck
# License: MIT

set -e

VERSION="0.1.0"
CACHE_DIR="$HOME/.cache/jumpscript"
PLUGIN_DIR="$(dirname "$(realpath "$0")")/plugins"

# Ensure cache directory exists
mkdir -p "$CACHE_DIR"

# Print usage information
usage() {
    echo "Usage: jumpscript [OPTIONS] [LANG] SCRIPT [ARGS...]"
    echo ""
    echo "Options:"
    echo "  -h, --help      Show this help message and exit"
    echo "  -v, --version   Show version information and exit"
    echo ""
    echo "Arguments:"
    echo "  LANG            Language to use (C, C++, Rust, etc.)"
    echo "                  If not provided, will be read from shebang line"
    echo "  SCRIPT          Script file to execute"
    echo "  ARGS...         Arguments to pass to the script"
    echo ""
    echo "jumpscript turns compiled languages into fast-launching scripts."
    exit 0
}

# Print version information
version() {
    echo "jumpscript version $VERSION"
    exit 0
}

# Parse command-line options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        -v|--version)
            version
            ;;
        *)
            break
            ;;
    esac
    shift
done

# Check if we have enough arguments
if [[ $# -lt 1 ]]; then
    echo "Error: No script or language provided" >&2
    usage
fi

# Check if the first argument is a language or a script
if [[ $# -ge 2 && -f "$2" && ! -f "$1" ]]; then
    # First argument is a language, second is a script
    LANG="$1"
    SCRIPT_PATH="$2"
    shift 2
else
    # First argument is a script, language should be in shebang
    SCRIPT_PATH="$1"
    shift
    
    # Check if the script exists
    if [[ ! -f "$SCRIPT_PATH" ]]; then
        echo "Error: Script '$SCRIPT_PATH' not found" >&2
        exit 1
    fi
    
    # Read the first line to get the language
    FIRST_LINE=$(head -n 1 "$SCRIPT_PATH")
    if [[ ! "$FIRST_LINE" =~ ^#!/usr/bin/env\ jumpscript\ (.+)$ ]]; then
        echo "Error: Invalid shebang line. Expected: #!/usr/bin/env jumpscript <LANG>" >&2
        exit 1
    fi
    
    LANG="${BASH_REMATCH[1]}"
fi

# Get the absolute path of the script
SCRIPT_PATH=$(realpath "$SCRIPT_PATH")
SCRIPT_MTIME=$(stat -c %Y "$SCRIPT_PATH" 2>/dev/null || stat -f %m "$SCRIPT_PATH")
ARCH=$(uname -m)
SCRIPT_HASH=$(echo "$SCRIPT_PATH" | md5sum | cut -d ' ' -f 1)
BINARY_CACHE="$CACHE_DIR/$SCRIPT_HASH-$ARCH-$SCRIPT_MTIME"

# Check if we have a cached binary
if [[ -x "$BINARY_CACHE" ]]; then
    exec "$BINARY_CACHE" "$@"
fi

# Load the plugin for the specified language
PLUGIN_PATH="$PLUGIN_DIR/$LANG.nix"
if [[ ! -f "$PLUGIN_PATH" ]]; then
    echo "Error: No plugin found for language '$LANG'" >&2
    exit 1
fi

# Create a temporary directory for building
TEMP_DIR=$(mktemp -d)
trap 'rm -rf "$TEMP_DIR"' EXIT

# Extract the script content (without the shebang line)
tail -n +2 "$SCRIPT_PATH" > "$TEMP_DIR/source"

# Parse the nix header if present
NIX_HEADER=""
NIX_ATTRS="{}"
if grep -q "^# nix:" "$TEMP_DIR/source"; then
    # Extract nix header block
    NIX_HEADER=$(grep -A 100 "^# nix:" "$TEMP_DIR/source" | 
                 sed -n '/^# nix:/,/^[^#]/p' | 
                 grep "^#" | 
                 sed 's/^# nix: \?//')
    
    # Remove the header from the source
    grep -v "^# nix:" "$TEMP_DIR/source" > "$TEMP_DIR/source.clean"
    mv "$TEMP_DIR/source.clean" "$TEMP_DIR/source"
    
    # Convert header to nix attrset
    NIX_ATTRS=$(echo "$NIX_HEADER" | tr '\n' ' ')
fi

# Determine file extension from plugin
FILE_EXT=$(nix-instantiate --eval -E "with import <nixpkgs> {}; (import $PLUGIN_PATH {}).fileExt" --json | tr -d '"')
SOURCE_PATH="$TEMP_DIR/source.$FILE_EXT"
mv "$TEMP_DIR/source" "$SOURCE_PATH"

# Create a simpler temporary nix file for the build
cat > "$TEMP_DIR/build.nix" <<'EOF'
with import <nixpkgs> {};
let
  plugin = import PLUGIN_PATH_PLACEHOLDER {};
  userAttrs = NIX_ATTRS_PLACEHOLDER;
  
  # Merge user attributes with plugin defaults
  attrs = {
    buildInputs = plugin.defaultBuildInputs or [];
    nativeBuildInputs = plugin.defaultNativeBuildInputs or [];
    preferStatic = plugin.preferStatic or true;
    pkgsBranch = "nixpkgs-unstable";
  } // userAttrs;
  
  # Create a shell with the specified packages
  buildShell = mkShell {
    inherit (attrs) buildInputs nativeBuildInputs;
    NIX_CFLAGS_LINK = if attrs.preferStatic then "-static" else "";
  };
  
  # Substitute variables in the compile command
  compileCommand = map 
    (arg: builtins.replaceStrings 
      ["sourcePath" "binaryPath"] 
      ["SOURCE_PATH_PLACEHOLDER" "BINARY_PATH_PLACEHOLDER"]
      arg)
    plugin.compileCommand;
    
  # Prepare the runner prefix if specified
  runnerPrefix = if plugin ? runner then "echo \"\${plugin.runner}\" > \"BINARY_PATH_PLACEHOLDER.tmp\" && cat \"BINARY_PATH_PLACEHOLDER\" >> \"BINARY_PATH_PLACEHOLDER.tmp\" && mv \"BINARY_PATH_PLACEHOLDER.tmp\" \"BINARY_PATH_PLACEHOLDER\"" else "";
in
{
  inherit buildShell compileCommand runnerPrefix;
}
EOF

# Replace placeholders with actual values
sed -i "s|PLUGIN_PATH_PLACEHOLDER|$PLUGIN_PATH|g" "$TEMP_DIR/build.nix"
sed -i "s|NIX_ATTRS_PLACEHOLDER|$NIX_ATTRS|g" "$TEMP_DIR/build.nix"
sed -i "s|SOURCE_PATH_PLACEHOLDER|$SOURCE_PATH|g" "$TEMP_DIR/build.nix"
sed -i "s|BINARY_PATH_PLACEHOLDER|$BINARY_PATH|g" "$TEMP_DIR/build.nix"

# Evaluate the nix expression
BUILD_INFO=$(nix-instantiate --eval "$TEMP_DIR/build.nix" --json)

# Extract the compile command and runner prefix
COMPILE_CMD=$(echo "$BUILD_INFO" | jq -r '.compileCommand[]')
RUNNER_PREFIX=$(echo "$BUILD_INFO" | jq -r '.runnerPrefix')

# Set up environment variables for the build
export SOURCE_PATH="$SOURCE_PATH"
export BINARY_PATH="$TEMP_DIR/binary"

# Run the build in a nix shell
echo "Building $SCRIPT_PATH..."
nix-shell "$TEMP_DIR/build.nix" -A buildShell --run "$(echo "$COMPILE_CMD" | tr '\n' ' ')"

# Apply runner prefix if needed
if [[ -n "$RUNNER_PREFIX" ]]; then
    eval "$RUNNER_PREFIX"
fi

# Make the binary executable
chmod +x "$BINARY_PATH"

# Cache the binary
cp "$BINARY_PATH" "$BINARY_CACHE"
chmod +x "$BINARY_CACHE"

# Execute the binary
exec "$BINARY_CACHE" "$@"
