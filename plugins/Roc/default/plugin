#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
	cat <<'USAGE'
Usage: plugin meta <script>
       plugin doctor
       plugin help

The script's double extension picks the backend:
  name.lua.roc  roc build --target=luajit, run with LuaJIT
  name.roc      roc build --opt=speed, run natively
The compiler is $JUMPSCRIPT_ROC, else `roc` on PATH (a Roc build with the
LuaJIT backend is needed for .lua.roc scripts).
USAGE
}

# The Roc compiler to build with: JUMPSCRIPT_ROC, else roc on PATH.
resolve_roc() {
	local roc="${JUMPSCRIPT_ROC:-}"
	if [[ -z "${roc}" ]]; then
		roc="$(command -v roc || true)"
	fi
	if [[ -z "${roc}" || ! -x "${roc}" ]]; then
		echo "Roc plugin needs a Roc compiler: set JUMPSCRIPT_ROC or put roc on PATH (got '${roc}')" >&2
		exit 1
	fi
	printf '%s\n' "${roc}"
}

resolve_luajit() {
	if [[ "${JUMPSCRIPT_NO_RUNTIME_DEPS:-0}" == "1" ]]; then
		local host
		host="$(command -v luajit || true)"
		if [[ -z "${host}" ]]; then
			echo "Roc plugin requires 'luajit' on PATH when --no-runtime-deps is set" >&2
			exit 1
		fi
		printf '%s\n' "${host}"
		return
	fi
	# Built (realized), not just evaluated: an evaluated store path may not exist yet.
	local store
	store="$(nix build --no-link --print-out-paths "${plugin_dir}#luajit")"
	printf '%s\n' "${store}/bin/luajit"
}

meta() {
	local script_path="${1:-}"
	if [[ -z "${script_path}" ]]; then
		echo "meta requires script path" >&2
		exit 1
	fi

	local roc script_base
	roc="$(resolve_roc)"
	script_base="$(basename "${script_path}")"

	if [[ "${script_base}" == ?*.wasm.roc ]]; then
		echo "Roc plugin: .wasm.roc is not supported yet (roc builds a headerless app for wasm32 as an archive that needs a WASI host)" >&2
		exit 1
	fi
	if [[ "${script_base}" == ?*.lua.roc ]]; then
		local luajit
		luajit="$(resolve_luajit)"
		cat <<META
lang=Roc
out_rel=lua/${script_base%.lua.roc}.lua
build_cmd='${roc}' build --target=luajit "\$JUMPSCRIPT_SCRIPT" --output="\$JUMPSCRIPT_ARTIFACT" >&2
rebuild_mode=mtime
exec_kind=lua
runtime_cmd=${luajit} {{artifact}}
META
	else
		cat <<META
lang=Roc
out_rel=bin/${script_base%.roc}
build_cmd='${roc}' build --opt=speed "\$JUMPSCRIPT_SCRIPT" --output="\$JUMPSCRIPT_ARTIFACT" >&2
rebuild_mode=mtime
exec_kind=bin
META
	fi
}

doctor() {
	resolve_roc >/dev/null
	echo "status=ok"
}

case "${1:-}" in
	meta)
		shift
		meta "$@"
		;;
	doctor)
		shift
		doctor "$@"
		;;
	help)
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
