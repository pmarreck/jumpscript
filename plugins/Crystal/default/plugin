#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
# Pure-Bash helpers: before the flake supplies tools, only nix and bash are assumed.
source "${plugin_dir}/../../_lib/plugin_lib.bash"

usage() {
	pl_cat <<'USAGE'
Usage: plugin meta <script>
       plugin doctor
       plugin help
USAGE
}

meta() {
	local script_path="${1:-}"
	if [[ -z "${script_path}" ]]; then
		echo "meta requires script path" >&2
		exit 1
	fi

	local script_base artifact_rel
	script_base="${script_path##*/}"
	artifact_rel="bin/${script_base%.*}"
	if [[ "${artifact_rel}" == "bin/" ]]; then
		artifact_rel="bin/artifact"
	fi

	local require_line require_path
	local -a deps=()
	while IFS= read -r require_line; do
		require_path="${require_line#require \"./}"
		require_path="${require_path%\"}"
		if [[ "${require_path}" != "${require_line}" ]]; then
			deps+=("${require_path}.cr")
		fi
	done < <(pl_matches 'require "\./[^"]+"' "${script_path}")

	local deps_value=""
	if (( ${#deps[@]} )); then
		deps_value="$(printf '%s:' "${deps[@]}")"
		deps_value="${deps_value%:}"
	fi

	local build_cmd
	pl_heredoc build_cmd <<'CMD'
nix develop __PLUGIN__#build --command bash --noprofile --norc -lc 'set -e; crystal build "$JUMPSCRIPT_SCRIPT" --release --no-color -o "$JUMPSCRIPT_ARTIFACT"'
CMD
	build_cmd="${build_cmd/__PLUGIN__/${plugin_dir}}"

	pl_cat <<META
lang=Crystal
out_rel=${artifact_rel}
build_cmd=${build_cmd}
rebuild_mode=mtime
exec_kind=bin
deps=${deps_value}
META
}

doctor() {
	if ! command -v nix >/dev/null 2>&1; then
		echo "status=missing-nix"
		exit 1
	fi
	echo "status=ok"
}

case "${1:-}" in
	meta)
		shift
		meta "$@"
		;;
	doctor)
		shift
		doctor "$@"
		;;
	help)
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
