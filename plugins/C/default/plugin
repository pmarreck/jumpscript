#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
	cat <<'EOF'
Usage: plugin meta <script>
       plugin doctor
       plugin help
EOF
}

meta() {
	local script_path="${1:-}"
	if [[ -z "${script_path}" ]]; then
		echo "meta requires script path" >&2
		exit 1
	fi

	local script_base artifact_rel
	script_base="$(basename "${script_path}")"
	artifact_rel="bin/${script_base%.*}"
	if [[ "${artifact_rel}" == "bin/" ]]; then
		artifact_rel="bin/artifact"
	fi

	local includes include_path
	local -a deps=()
	while IFS= read -r includes; do
		include_path="${includes#\#include \"}"
		include_path="${include_path%\"}"
		if [[ -n "${include_path}" ]]; then
			deps+=("${include_path}")
		fi
	done < <(tail -n +2 "${script_path}" | grep -oE '#include "[^"]+"' || true)

	local deps_value=""
	if (( ${#deps[@]} )); then
		deps_value="$(printf '%s:' "${deps[@]}")"
		deps_value="${deps_value%:}"
	fi

	local build_cmd
	build_cmd=$(cat <<'CMD'
nix develop __PLUGIN__#build --command bash --noprofile --norc -lc 'set -e; script_dir="$(dirname "$JUMPSCRIPT_SCRIPT")"; tail -n +2 "$JUMPSCRIPT_SCRIPT" | cc -O2 -xc - -iquote "$script_dir" -o "$JUMPSCRIPT_ARTIFACT"'
CMD
)
	build_cmd="${build_cmd/__PLUGIN__/${plugin_dir}}"

	cat <<META
lang=C
out_rel=${artifact_rel}
build_cmd=${build_cmd}
rebuild_mode=mtime
exec_kind=bin
deps=${deps_value}
META
}

doctor() {
	if command -v cc >/dev/null 2>&1; then
		echo "status=ok"
	else
		echo "status=missing-cc"
		exit 1
	fi
}

case "${1:-}" in
	meta)
		shift
		meta "$@"
		;;
	doctor)
		shift
		doctor "$@"
		;;
	help)
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
